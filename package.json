{
  "name": "temp-init",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "catalogo:extract": "python3 scripts/reprocessar-catalogo-completo.py",
    "catalogo:extract-lobinho": "python3 scripts/extrair-catalogo-pn-lobinho.py",
    "catalogo:extract-senior": "python3 scripts/extrair-catalogo-pn-senior.py",
    "db:seed-pa": "node --env-file=.env scripts/seed-catalogo-pa-multiramo.mjs",
    "db:seed-catalogo": "node --env-file=.env scripts/seed-catalogo.mjs",
    "db:seed-pn-lobinho": "node --env-file=.env scripts/seed-catalogo-pn-lobinho.mjs",
    "db:seed-pn-senior": "node --env-file=.env scripts/seed-catalogo-pn-senior.mjs",
    "db:seed-jovens": "node --env-file=.env scripts/merge-or-pa-pn.mjs",
    "db:setup-producao": "npm run db:seed-pa && npm run db:seed-catalogo && npm run db:seed-pn-lobinho && npm run db:seed-pn-senior && npm run db:seed-jovens && npm run progressoes:transicao",
    "db:backfill-progressao": "npx tsx --env-file=.env scripts/backfill-progressao-relacional.mjs",
    "db:embeddings:progressao": "python3 scripts/gerar-embeddings-progressao.py",
    "progressoes:transicao": "npx -y tsx --env-file=.env scripts/run-transicao.mjs",
    "paxtu:login": "node --env-file=.env scripts/paxtu-login.mjs",
    "paxtu:scrape": "node --env-file=.env scripts/paxtu-scrape.mjs",
    "paxtu:fetch-raw": "node --env-file=.env scripts/fetch-antonia-raw.mjs",
    "paxtu:fetch-all": "npx tsx --env-file=.env scripts/extrair-todos-dados-brutos.mjs",
    "paxtu:backup": "npx tsx --env-file=.env scripts/backup-paxtu-completo.mjs",
    "paxtu_pa:login": "node --env-file=.env scripts/paxtu-pa-login.mjs",
    "paxtu_pa:backup": "node --env-file=.env scripts/backup-paxtu-pa.mjs",
    "test:integration": "npx -y tsx --env-file=.env tests/integration/transicao.test.ts",
    "test:progressao-relacional": "npx -y tsx --env-file=.env tests/integration/progressao-relacional.test.ts",
    "test:especialidades": "npx -y tsx --env-file=.env tests/integration/especialidades-transicao.test.ts",
    "test:progressao-atualizada": "npx -y tsx --env-file=.env tests/integration/progressao-transicao-atualizada.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "pg": "^8.23.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
